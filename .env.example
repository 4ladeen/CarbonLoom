# ==============================================================================
# CarbonLoom — Environment Configuration Template (.env.example)
# Copy this file to .env and configure secrets for your deployment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core API & Gateway Server Settings
# ------------------------------------------------------------------------------
APP_ENV=development
APP_PORT=8000
GATEWAY_PORT=8080
LOG_LEVEL=info

# JWT & Cryptographic Approval Secrets
JWT_SECRET=carbonloom_super_secret_jwt_key_2026_change_in_production
HMAC_APPROVAL_SECRET=carbonloom_approval_hmac_secret_2026
ED25519_KEY_PATH=./keys/auditor_ed25519.pem

# ------------------------------------------------------------------------------
# 2. Database Connections (Docker Compose defaults)
# ------------------------------------------------------------------------------
# PostgreSQL 16 (Relational, Multi-Tenant RLS & BGE-M3 Embeddings)
POSTGRES_USER=carbonloom
POSTGRES_PASSWORD=carbonloom_secret_2026
POSTGRES_DB=carbonloom_db
DATABASE_URL=postgresql://carbonloom:carbonloom_secret_2026@localhost:5432/carbonloom_db

# TimescaleDB (Time-Series Meter Telemetry)
TIMESCALE_USER=carbonloom_ts
TIMESCALE_PASSWORD=timescale_secret_2026
TIMESCALE_DB=carbonloom_telemetry
TIMESCALE_URL=postgresql://carbonloom_ts:timescale_secret_2026@localhost:5433/carbonloom_telemetry

# Neo4j Graph Database (EU CBAM/ESPR Ontology & Equipment Topology)
NEO4J_USER=neo4j
NEO4J_PASSWORD=carbonloom_neo4j_2026
NEO4J_URI=bolt://localhost:7687

# Redis 7.2 (Token Spend Caps, Rate Limiting & Approval Tokens)
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 3. Object Storage (MinIO S3-Compatible)
# ------------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=localhost:9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_EVIDENCE=carbonloom-evidence
MINIO_BUCKET_PASSPORTS=carbonloom-passports
MINIO_USE_SSL=false

# ------------------------------------------------------------------------------
# 4. Event Streaming & Edge Telemetry
# ------------------------------------------------------------------------------
NATS_URL=nats://localhost:4222
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
EDGE_BUFFER_DB_PATH=./edge/data/edge_buffer.db

# ------------------------------------------------------------------------------
# 5. Frontier LLM & Local Model Endpoints (For LangGraph Agents)
# ------------------------------------------------------------------------------
# Frontier reasoning model (Claude 3.5 Sonnet / Opus for Supervisor & Critic)
ANTHROPIC_API_KEY=

# Secondary / Embedding model (BGE-M3 / OpenAI for fast extraction)
OPENAI_API_KEY=

# Local Offline Fallback Model (Ollama Mini-PC on Factory Floor)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# ------------------------------------------------------------------------------
# 6. Observability & Tracing
# ------------------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
