{
  "name": "carbonloom",
  "version": "2.0.0",
  "private": true,
  "description": "Agentic Energy, Carbon Accounting & Compliance Operating System for Export Factories",
  "scripts": {
    "dev": "npm run serve",
    "build": "npm run build:skyline",
    "build:skyline": "esbuild scripts/carbon-ascii.ts --bundle --outfile=js/carbon-skyline.js --format=iife --global-name=CarbonAsciiSkyline",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:python",
    "test:python": "PYTHONPATH=. pytest sim/ circuits/ fabric/ eval/ services/",
    "serve": "python3 -m http.server 8080",
    "sim": "PYTHONPATH=. python3 -m sim.data_generator"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "autoprefixer": "^10.7.0",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.33",
    "prettier": "^3.2.5",
    "puppeteer-core": "^25.18.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@paper-design/shaders": "^0.0.82",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.1"
  }
}
