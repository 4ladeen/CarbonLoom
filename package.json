{
  "name": "carbonloom",
  "version": "2.0.0",
  "private": true,
  "description": "Agentic Energy, Carbon Accounting & Compliance Operating System for Export Factories",
  "workspaces": [
    "apps/*",
    "circuits",
    "mcp/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces",
    "build": "npm run build --workspaces",
